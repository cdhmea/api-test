doctype html
html
  head
    title Список пользователей
  body
    h1 Все пользователи
    a(href="/users/create") Добавить нового
    ul
      each user in users
        li 
          b #{user.name} 
          | (#{user.email}) 
          form(method="POST" action=`/users/delete/${user.id}` style="display:inline; margin-left:10px;")
            button(type="submit") Удалить
    hr
    a(href="/") На главную